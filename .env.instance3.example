# Environment configuration for OpenEVSE GUI Instance 3
# Copy this to .env when running the third instance locally (not in Docker)
#
# To run multiple instances simultaneously on the same machine:
# 1. Use different terminals/tmux sessions
# 2. Use different ports by setting VITE_PORT
# 3. Each instance should point to a different OpenEVSE host
#
# Usage in a third terminal:
#   cp .env.instance3.example .env
#   VITE_PORT=5175 npm run dev
#
# The GUI will be available at http://localhost:5175

VITE_OPENEVSEHOST = "openevse3.local"
NODE_ICU_DATA = "$(pwd)/node_modules/full-icu" node

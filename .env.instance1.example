# Environment configuration for OpenEVSE GUI Instance 1
# Copy this to .env when running the first instance locally (not in Docker)
#
# Usage:
#   cp .env.instance1.example .env
#   npm run dev
#
# The GUI will be available at http://localhost:5173

VITE_OPENEVSEHOST = "openevse1.local"
NODE_ICU_DATA = "$(pwd)/node_modules/full-icu" node
